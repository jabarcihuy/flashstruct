# Salinan skills untuk berbagai agen — sumber aslinya di .agents/skills/
# Tool `npx skills add` membuat salinan ini untuk kompatibilitas,
# tapi isinya identik. Cukup simpan satu agar repo bersih.
/agent/
/.claude/skills/

# Binary skill impeccable (platform-specific, 16 MB)
# Skill-nya sendiri di-commit, tapi binary-nya tidak.
# Cara memasang ulang: lihat docs/19-CATATAN-SKILL.md
.agents/skills/impeccable/scripts/bin/

# Duplikat skill untuk agen lain (sumber asli di .agents/skills/)
# Tool pemasang skill membuat salinan ini untuk kompatibilitas.
# Isinya identik, jadi cukup simpan satu agar repo tidak membengkak.
/.claude/skills/

# Hasil test Playwright — artefak, bukan sumber
test-results/
playwright-report/
blob-report/
playwright/.cache/

# =========================================================
# Artefak kerja redesign (skill impeccable)
#
# Yang DI-COMMIT (kecil, jadi rujukan):
#   .impeccable/HANDOFF.md        — catatan sesi redesign
#   .impeccable/direction-choice.json — keputusan arah yang disetujui
#   .impeccable/surfaces/         — kontrak per halaman
#   .impeccable/build/spec.json   — hasil ukur comp
#   .impeccable/mocks/komposisi-a.png — comp YANG DISETUJUI (otoritas desain)
#
# Yang TIDAK di-commit (besar, bisa dibuat ulang):
#   comp B/C yang tidak disetujui, mock keputusan, screenshot review,
#   grid comp, crop font-match. Total ~12 MB dan semuanya regenerable
#   dengan menjalankan ulang tool impeccable.
# =========================================================
.impeccable/mocks/komposisi-b.png
.impeccable/mocks/komposisi-c.png
.impeccable/mocks/decision/
.impeccable/review/
.impeccable/build/comp-grid.png
.impeccable/build/font-match/
.impeccable/questions/
.impeccable/live/
