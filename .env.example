# =========================================================
# FlashStruct — Template Environment Variable
#
# Salin berkas ini menjadi .env.local lalu isi nilai sebenarnya:
#   cp .env.example .env.local
#
# .env.local TIDAK boleh di-commit (sudah ada di .gitignore).
#
# Cara mendapatkan nilai di bawah:
#   1. Buka project di https://supabase.com
#   2. Settings > API Keys
#   3. Salin "Project URL" dan "Publishable key"
#
# Rincian: docs/09-PANDUAN-SETUP.md §3.2
# =========================================================

# URL project Supabase
# Contoh: https://abcdefghijklmn.supabase.co
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key — AMAN diekspos ke browser SELAMA RLS aktif.
# Contoh: sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
#
# Yang melindungi data adalah RLS, bukan kerahasiaan key ini.
#
# JANGAN pernah memakai service_role / sb_secret_ di frontend —
# key itu melewati RLS dan memberi akses penuh ke database.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
